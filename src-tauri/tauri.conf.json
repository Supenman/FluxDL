{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxDL",
  "version": "0.4.2",
  "identifier": "com.fluxdl.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FluxDL · 迅流下载器",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../browser-extension": "browser-extension/",
      "../tools/README.md": "tools/README.md",
      "../tools/build-update-manifest.py": "tools/build-update-manifest.py",
      "../tools/check-release.py": "tools/check-release.py",
      "../tools/fetch-tools.sh": "tools/fetch-tools.sh",
      "../tools/aria2c.exe": "tools/aria2c.exe",
      "../tools/ffmpeg.exe": "tools/ffmpeg.exe",
      "../tools/yt-dlp.exe": "tools/yt-dlp.exe"
    },
    "shortDescription": "更顺手的桌面下载器",
    "longDescription": "FluxDL 迅流下载器：多线程 HTTP 下载、断点续传、队列、限速、视频下载与命令面板。",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
