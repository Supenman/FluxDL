{
  "manifest_version": 3,
  "name": "FluxDL 链接捕获",
  "version": "1.0.0",
  "description": "把浏览器里的下载链接一键发送到 FluxDL 桌面下载器。",
  "permissions": ["contextMenus", "downloads", "storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:35917/*",
    "http://localhost:35917/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FluxDL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "102"
}
