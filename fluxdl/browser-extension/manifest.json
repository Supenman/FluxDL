{
  "manifest_version": 3,
  "name": "FluxDL 资源捕获",
  "version": "2.2.0",
  "description": "自动接管浏览器下载，嗅探页面音视频资源，并发送到 FluxDL 桌面下载器。不读取、不传输任何登录凭证。",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:35917/*",
    "http://localhost:35917/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FluxDL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "102"
}
